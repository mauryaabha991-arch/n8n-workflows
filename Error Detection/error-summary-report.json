    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst since = $now.minus({ hours: 24 });   // use { days: 7 } for weekly\n\nconst recent = rows.filter(r => {\n  if (!r.Timestamp) return false;\n  const t = DateTime.fromFormat(r.Timestamp, 'yyyy-MM-dd HH:mm:ss');\n  return t.isValid && t >= since;\n});\n\n// Slack requires these 3 characters to be escaped\nconst esc = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst count = (key) => recent.reduce((a, r) => {\n  const k = r[key] || 'Unknown';\n  a[k] = (a[k] || 0) + 1;\n  return a;\n}, {});\n\nconst byWf = count('Workflow_name');\nconst bySev = count('Severity');\n\nconst lines = (o) => Object.entries(o)\n  .map(([k, v]) => `• ${esc(k)}: *${v}*`)\n  .join('\\n') || '• None';\n\nconst latest = recent.slice(-5)\n  .map(r => `• ${esc(r.Timestamp)} | ${esc(r.Workflow_name)} | ${esc(r.Failed_node)} | ${esc(r.Error_message)}`)\n  .join('\\n') || '• None';\n\nconst text =\n`📊 *n8n Error Summary (last 24 hours)*\nTotal errors: *${recent.length}*\n\n*By severity*\n${lines(bySev)}\n\n*By workflow*\n${lines(byWf)}\n\n*Latest errors*\n${latest}`;\n\nreturn [{ json: { total: recent.length, text } }];"
      },
      "type": "n8n-nodes-base.code",
