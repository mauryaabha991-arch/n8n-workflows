      "name": "Send a message",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "credentials": {
        "slackOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Your slackOAuth2Api"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const msg = ($json.Error_message || '').toLowerCase();\n\n// Transient: usually temporary, a retry may fix it\nconst transient = /timeout|timed out|etimedout|econnreset|econnrefused|429|502|503|504|rate limit|too many requests/.test(msg);\n\n// Critical: needs a human (auth, permissions, server/code errors)\nconst critical = /401|403|unauthorized|forbidden|invalid credentials|authentication|permission|500|cannot read|is not defined|database/.test(msg);\n\n// Info: bad input / validation\nconst info = /required|validation|invalid input|400|not found|404/.test(msg);\n\nlet severity = 'Warning';\nif (critical) severity = 'Critical';\nelse if (transient) severity = 'Warning';\nelse if (info) severity = 'Info';\n\nreturn {\n  json: {\n    ...$json,\n    Severity: severity,\n    Transient: transient,\n    Date: $now.toFormat('yyyy-MM-dd')\n  }\n};"
      },
