      "name": "Webhook"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\n\nfor (const item of $input.all()) {\n  // Webhook data arrives under body\n  const src = item.json.body || item.json;\n\n  const name  = String(src.name  ?? '').trim();\n  const email = String(src.email ?? '').trim().toLowerCase();\n  const phone = String(src.phone ?? '').trim();\n  const notes = String(src.notes ?? '').trim();\n\n  // Clean budget: remove commas, currency symbols, spaces\n  const rawBudget = String(src.budget ?? '').replace(/[^0-9.]/g, '');\n  const budget = rawBudget === '' ? null : Number(rawBudget);\n\n  // Validation checks\n  const emailValid  = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n  const budgetValid = budget !== null && !isNaN(budget) && budget >= 0;\n\n  const issues = [];\n  if (!name) issues.push('missing name');\n  if (!emailValid) issues.push('missing/invalid email');\n  if (!budgetValid) issues.push('missing/invalid budget');\n\n  // Keyword detection (easy to modify: edit this list)\n  const HOT_KEYWORDS = ['urgent', 'immediate', 'immediately', 'asap'];\n  const hasHotKeyword = HOT_KEYWORDS.some(k => notes.toLowerCase().includes(k));\n\n  // Score out of 10\nlet score = 0;\nif (budgetValid) {\n  if (budget >= 100000) score += 5;\n  else if (budget > 50000) score += 4;\n  else if (budget >= 10000) score += 3;\n  else if (budget > 0) score += 1;\n}\nif (hasHotKeyword) score += 2;\nif (emailValid) score += 1;\nif (phone.replace(/\\D/g, '').length >= 10) score += 1;\nif (notes.length > 20) score += 1;\nscore = Math.max(1, Math.min(10, score));\n\n  out.push({\n    json: {\n      name,\n      email,\n      phone,\n      budget: budgetValid ? budget : null,\n      notes,\n    \n      hasHotKeyword,\n      score,\n      isIncomplete: issues.length > 0,\n      issues: issues.join(', '),\n      receivedAt: new Date().toISOString()\n    }\n  });\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
