        "jsCode": "const body = $input.first().json.body;\nconst p = String(body.priority || 'low').trim().toLowerCase();\n\nconst routes = {\n  high:   ['email', 'slack', 'telegram'],\n  medium: ['slack', 'telegram'],\n  low:    ['slack']\n};\n\nconst emojis = { high: '🔴', medium: '🟠', low: '🟢' };\nconst key = routes[p] ? p : 'low';\n\nreturn [{\n  json: {\n    subject: body.subject,\n    message: body.message,\n    priority: key.charAt(0).toUpperCase() + key.slice(1),\n    emoji: emojis[key],\n    platforms: routes[key],\n    timestamp: new Date().toISOString()\n  }\n}];"
