    {
      "parameters": {
        "jsCode": "const today = new Date().toISOString().slice(0, 10);\nconst rows = $input.all().map(i => i.json)\n  .filter(r => (r.Timestamp || '').startsWith(today));\n\nconst counts = {};\nlet urgent = 0;\nrows.forEach(r => {\n  counts[r.Category] = (counts[r.Category] || 0) + 1;\n  if (r.Priority === 'High') urgent++;\n});\n\nlet report = `Daily Report - ${today}\\nTotal queries: ${rows.length}\\nHigh priority: ${urgent}\\n\\nBy category:\\n`;\nfor (const [cat, n] of Object.entries(counts)) report += `- ${cat}: ${n}\\n`;\n\nreturn [{ json: { report } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
