        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.output || $json.text || '';\nlet data;\ntry {\n  data = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  data = {\n    category: 'Other',\n    sentiment: 'Neutral',\n    priority: 'High',\n    reply: 'Thank you for contacting us. Our team will reply within 24 hours.'\n  };\n}\n\nconst hook = $('Webhook').item.json.body;\n\nreturn {\n  json: {\n    name: hook.name,\n    email: hook.email,\n    message: hook.message,\n    category: data.category,\n    sentiment: data.sentiment,\n    priority: data.priority,\n    reply: data.reply,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
