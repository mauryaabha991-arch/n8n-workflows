    {
      "parameters": {
        "jsCode": "const prev = $('Duplicate Check').first().json;\nconst out = $input.first().json.output || {};\n\nlet text = String(out.content || '').trim();\ntext = text.replace(/^```[a-zA-Z]*\\n?/, '').replace(/```$/, '').replace(/\\n{3,}/g, '\\n\\n').trim();\nif (!text) throw new Error('Agent returned empty content');\n\nreturn [{ json: {\n  id: 'C-' + Date.now(),\n  timestamp: new Date().toISOString(),\n  topic: prev.topic,\n  topic_key: prev.topic_key,\n  content_type: prev.content_type,\n  tone: prev.tone,\n  language: prev.language,\n  word_count: text.split(/\\s+/).length,\n  generated_text: text,\n  status: 'Pending Approval',\n  reviewer_email: prev.reviewer_email\n} }];"
      },
