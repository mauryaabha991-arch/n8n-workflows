    {
      "parameters": {
        "jsCode": "const input = $('Validate Input').first().json;\n\n// Sheet headers may be capitalised (Topic_key) or lowercase (topic_key) - normalise keys\nconst rows = $input.all().map(i => {\n  const o = {};\n  for (const [k, v] of Object.entries(i.json)) o[k.toLowerCase()] = v;\n  return o;\n}).filter(r => r.topic_key);\n\nconst matches = rows.filter(r => String(r.topic_key) === input.topic_key);\nmatches.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));\nconst match = matches[0];\nconst is_duplicate = !!match && !input.force;\n\nreturn [{ json: {\n  ...input,\n  is_duplicate,\n  existing: match ? { id: match.id, timestamp: match.timestamp, status: match.status, generated_text: match.generated_text } : null\n} }];"
      },
