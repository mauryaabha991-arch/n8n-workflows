    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst prev = $('Duplicate Check').first().json;\nconst raw = String(e.error || (e.error && e.error.message) || e.message || JSON.stringify(e)).slice(0, 500);\n\nlet user_message = 'The AI service failed. Please try again shortly.';\nif (/401|api key|incorrect api/i.test(raw)) user_message = 'Invalid or missing OpenAI API key.';\nelse if (/429|rate limit|quota/i.test(raw)) user_message = 'Rate limit or quota exceeded. Retry later.';\nelse if (/5\\d\\d|server error|overloaded/i.test(raw)) user_message = 'OpenAI server issue. Retry later.';\n\nreturn [{ json: { timestamp: new Date().toISOString(), topic: prev.topic, content_type: prev.content_type, http_code: '', error_message: raw, user_message } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
