    {
      "parameters": {
        "promptType": "define",
        "text": "=Create content with these details:\n\nTopic: {{ $json.topic }}\nContent type: {{ $json.content_type }}\nTone: {{ $json.tone }}\nLength: {{ $json.length }}\nLanguage: {{ $json.language }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert content writer. Write original, accurate, engaging content.\n\nPick the template by content_type:\n- blog_post: headline, hook intro, 3-5 sections with subheadings, conclusion with a call to action.\n- social_media_caption: strong first-line hook, core message, call to action, 3-5 hashtags, at most 1-3 emojis.\n- email_draft: begin with \"Subject:\" line, greeting, opening, main message, call to action, sign-off with [Your Name].\n- product_description: punchy headline, short benefit-led paragraph, 3-5 feature bullets, closing line.\n\nTarget word counts by length:\n- blog_post: short 300-400, medium 600-800, long 1200-1500\n- social_media_caption: short 15-25, medium 30-50, long 60-90\n- email_draft: short 80-120, medium 150-220, long 300-400\n- product_description: short 40-60, medium 80-120, long 150-220\n\nWrite the ENTIRE output in the requested language.\nDo not add preambles, explanations or code fences. Put only the final content in the \"content\" field."
        }
      },
