    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst b = item.body || item;\nconst allowed = ['blog_post','social_media_caption','email_draft','product_description'];\nconst errors = [];\n\nconst topic = String(b.topic || '').trim();\nconst content_type = String(b.content_type || '').trim().toLowerCase().replace(/\\s+/g, '_');\nconst tone = String(b.tone || 'professional').toLowerCase();\nconst length = ['short','medium','long'].includes(String(b.length).toLowerCase()) ? String(b.length).toLowerCase() : 'medium';\nconst language = String(b.language || 'English').trim();\nconst force = b.force === true || b.force === 'true';\nconst reviewer_email = String(b.reviewer_email || 'you@gmail.com').trim();\n\nif (!topic) errors.push('\"topic\" is required');\nif (!allowed.includes(content_type)) errors.push('\"content_type\" must be one of: ' + allowed.join(', '));\n\nconst normalized = topic.toLowerCase().replace(/[^\\p{L}\\p{N}\\s]/gu, '').replace(/\\s+/g, ' ').trim();\nconst topic_key = normalized + '|' + content_type + '|' + language.toLowerCase();\n\nreturn [{ json: { valid: errors.length === 0, errors, topic, content_type, tone, length, language, force, reviewer_email, topic_key } }];"
      },
