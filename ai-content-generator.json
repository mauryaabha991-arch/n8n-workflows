    {
      "parameters": {
        "jsCode": "const d = $('Format Response').first().json;\nlet t = String(d.generated_text || '');\n\n// Markdown headings (# ## ###) -> Slack bold\nt = t.replace(/^#{1,6}\\s*(.+)$/gm, '*$1*');\n\n// Markdown **bold** -> Slack *bold*\nt = t.replace(/\\*\\*(.+?)\\*\\*/g, '*$1*');\n\n// Markdown links [text](url) -> Slack <url|text>\nt = t.replace(/\\[(.+?)\\]\\((.+?)\\)/g, '<$2|$1>');\n\n// Markdown bullets (- item or * item) -> •\nt = t.replace(/^\\s*[-*]\\s+/gm, '• ');\n\n// Remove extra blank lines\nt = t.replace(/\\n{3,}/g, '\\n\\n').trim();\n\n// Friendly label: blog_post -> Blog Post\nconst label = String(d.content_type || '')\n  .replace(/_/g, ' ')\n  .replace(/\\b\\w/g, c => c.toUpperCase());\n\nconst slack_text =\n  `:memo: *New ${label} approved*\\n` +\n  `*Topic:* ${d.topic}\\n` +\n  `*Language:* ${d.language}\\n` +\n  `──────────────────\\n\\n` +\n  t;\n\nreturn [{ json: { slack_text } }];"
      },
      "type": "n8n-nodes-base.code",
