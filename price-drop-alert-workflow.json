    {
      "parameters": {
        "jsCode": "return [\n  { json: { productId: 1, threshold: 15, productUrl: \"https://dummyjson.com/products/1\" } },\n  { json: { productId: 2, threshold: 10, productUrl: \"https://dummyjson.com/products/2\" } },\n  { json: { productId: 3, threshold: 8,  productUrl: \"https://dummyjson.com/products/3\" } }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        16
      ],
      "id": "6b69e9d0-075f-4858-8f76-a94a32f7da51",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nif (!sd.lastPrice) sd.lastPrice = {};\n\nfor (const item of $input.all()) {\n  const id = item.json.productId;\n  const cur = item.json.price;\n  const prev = sd.lastPrice[id];\n\n  let trend = 'First check';\n  if (prev !== undefined) {\n    if (cur > prev) trend = 'Rising';\n    else if (cur < prev) trend = 'Falling';\n    else trend = 'Stable';\n  }\n\n  item.json.previousPrice = prev ?? '';\n  item.json.trend = trend;\n  sd.lastPrice[id] = cur;\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "id": "ca326028-9cea-431c-896a-aa944f46e33d",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nif (!sd.lastAlert) sd.lastAlert = {};\n\nconst COOLDOWN_HOURS = 24;\nconst now = Date.now();\n\nfor (const item of $input.all()) {\n  const id = item.json.productId;\n  const below = item.json.price < item.json.threshold;\n  const hoursSince = (now - (sd.lastAlert[id] || 0)) / 3600000;\n\n  if (!below) {\n    item.json.sendAlert = false;\n    item.json.status = 'Above threshold';\n  } else if (hoursSince >= COOLDOWN_HOURS) {\n    item.json.sendAlert = true;\n    item.json.status = 'Alert sent';\n    sd.lastAlert[id] = now;\n  } else {\n    item.json.sendAlert = false;\n    item.json.status = 'Cooldown (skipped)';\n  }\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        0
      ],
      "id": "af6e7b71-fdff-4302-95a2-187732bb7583",
      "name": "Code in JavaScript2"
    }
