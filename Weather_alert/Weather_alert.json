    {
      "parameters": {
        "jsCode": "return [\n  { json: { city: 'Varanasi,IN' } },\n  { json: { city: 'Lucknow,IN' } },\n  { json: { city: 'Delhi,IN' } }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "b04061c9-f9ca-4749-b629-e364ca36a322",
      "name": "All_CIty_Node"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json;\nconst next = d.list;                       // next 24 hours\nconst rainWords = ['Rain', 'Drizzle', 'Thunderstorm'];\nconst rainy = next.filter(e => rainWords.includes(e.weather[0].main));\nconst slot = rainy[0] || next[0];\n\nreturn { json: {\n  city: d.city.name,\n  checkedAt: $now.toFormat('yyyy-MM-dd HH:mm'),\n  rainExpected: rainy.length > 0,\n  condition: slot.weather[0].description,\n  temperature: slot.main.temp,\n  humidity: slot.main.humidity,\n  windSpeed: slot.wind.speed,\n  rainTime: rainy.length ? slot.dt_txt : '',\n  rainChance: Math.round(Math.max(...next.map(e => e.pop || 0)) * 100)\n}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "3462b481-cb1c-49e8-9a60-0e47e43100fd",
      "name": "Filter_parameter_node"
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL",
