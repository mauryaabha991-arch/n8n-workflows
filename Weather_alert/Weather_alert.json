        "message": "=Rain expected in {{ $json.city }} around {{ $json.rainTime }} Condition: {{ $json.condition }} Temperature: {{ $json.temperature }} °C Humidity: {{ $json.humidity }}% Wind: {{ $json.windSpeed }} m/s Chance of rain: {{ $json.rainChance }}%",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
